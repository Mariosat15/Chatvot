# ============================================================
# CHARTVOLT — COMPLETE ENVIRONMENT VARIABLE REFERENCE
# ============================================================
#
# Copy this file to the project root as .env and fill in values.
#   cp deploy/env.example .env
#
# KEY:
#   [REQUIRED]          App will not start without this.
#   [REQUIRED-MULTI]    Required AND must be identical on every server in the fleet.
#   [IMPORTANT]         Core feature (charts, email, KYC) disabled without this.
#   [IMPORTANT-MULTI]   Same as above AND must match across servers.
#   [OPTIONAL]          Feature degrades gracefully without this.
#   [AUTO]              Auto-generated by setup script — do not change unless resetting.
#   [DO NOT SET]        Let Admin Panel manage this — setting it here overrides DB.
#
# ADMIN PANEL vs .ENV:
#   Many settings can be managed in Admin Panel > Settings.
#   If a variable is ALSO set in .env, the .env value takes priority.
#   For multi-server deployments this is dangerous: Server 2 might have a
#   different .env value than what is in the shared database, causing
#   authentication failures or API signature mismatches.
#   BEST PRACTICE: for third-party API keys, use ONE source of truth:
#     - Either Admin Panel only (leave .env blank)
#     - Or .env only (keep Admin Panel blank and ensure all servers match)
# ============================================================


# ─────────────────────────────────────────────────────────────
# SECTION 1 — CORE  (all required)
# ─────────────────────────────────────────────────────────────

# [REQUIRED] Node environment
NODE_ENV=production

# [AUTO] Unique identifier for this server instance (for fleet management)
# Generated by setup script. Keep unique per server.
SERVER_ID=

# [REQUIRED] Set to "false" on secondary servers (no worker, no DB seed)
IS_PRIMARY=true

# [REQUIRED] Public URLs — used in emails, OAuth redirects, CSP headers
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com


# ─────────────────────────────────────────────────────────────
# SECTION 2 — DATABASE
# ─────────────────────────────────────────────────────────────

# [REQUIRED-MULTI] MongoDB Atlas connection string
# All servers must point to the same cluster.
# Get from: MongoDB Atlas > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chartvolt


# ─────────────────────────────────────────────────────────────
# SECTION 3 — AUTHENTICATION  (must match across all servers)
# ─────────────────────────────────────────────────────────────

# [REQUIRED-MULTI] JWT signing secret for user sessions (BetterAuth)
# Generate: openssl rand -hex 32
# ALL servers MUST share the same value. Mismatch = users get logged out
# when Cloudflare routes them to a different server.
BETTER_AUTH_SECRET=

# [REQUIRED] App base URL for OAuth redirect callbacks
BETTER_AUTH_URL=https://yourdomain.com

# [REQUIRED-MULTI] Admin panel JWT signing secret
# Generate: openssl rand -hex 32
ADMIN_JWT_SECRET=

# [REQUIRED] Admin super-user credentials (first login)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# [REQUIRED-MULTI] Shared secret for internal service-to-service API calls
# (worker → web app, admin → web app, etc.)
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# [REQUIRED-MULTI] Shared key for internal admin route protection
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=


# ─────────────────────────────────────────────────────────────
# SECTION 4 — PORTS & INTERNAL URLS
# ─────────────────────────────────────────────────────────────

# [REQUIRED] API server port
API_PORT=4000

# [REQUIRED] WebSocket server port
WEBSOCKET_PORT=3003

# [REQUIRED] Public WebSocket URL (shown to browsers)
NEXT_PUBLIC_WEBSOCKET_URL=wss://yourdomain.com/ws

# [REQUIRED] Internal WebSocket URL (server-to-server)
WEBSOCKET_INTERNAL_URL=http://localhost:3003

# [OPTIONAL] Alternative internal WebSocket URL alias
# WS_INTERNAL_URL=http://localhost:3003

# [OPTIONAL] WebSocket host (used by profile sync service)
# WEBSOCKET_HOST=localhost


# ─────────────────────────────────────────────────────────────
# SECTION 5 — REDIS
# ─────────────────────────────────────────────────────────────
# Redis is configured via Admin Panel > Settings > Redis.
# Setting these env vars overrides the admin panel values.
#
# Primary server: leave commented (Redis runs on localhost, managed by setup script)
# Secondary server: uncomment and fill in primary server's Redis credentials.

# [OPTIONAL] Redis connection details
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://:PASSWORD@HOST:PORT


# ─────────────────────────────────────────────────────────────
# SECTION 6 — TRADING DATA  (Massive.com)
# ─────────────────────────────────────────────────────────────
# Without these, charts won't load and prices won't stream.
# Can also be set in Admin Panel > Settings > Environment Variables.
# Get keys at https://massive.com

# [IMPORTANT] Server-side key — used for historical candle fetching
# MASSIVE_API_KEY=

# [IMPORTANT] Client-side key — used for browser WebSocket price streaming
# NEXT_PUBLIC_MASSIVE_API_KEY=


# ─────────────────────────────────────────────────────────────
# SECTION 7 — EMAIL  (Nodemailer)
# ─────────────────────────────────────────────────────────────
# Without this, users won't receive welcome emails, password resets, or alerts.
# Can also be set in Admin Panel > Settings > Environment Variables.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com > Security > App Passwords
#   3. Create an app password for "Mail"
#   4. Use that 16-char password below (NOT your regular Gmail password)

# [IMPORTANT] Sender email address
# NODEMAILER_EMAIL=noreply@yourdomain.com

# [IMPORTANT] Gmail App Password (16 characters, no spaces)
# NODEMAILER_PASSWORD=

# [OPTIONAL] Alternative SMTP settings (if not using Gmail)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=


# ─────────────────────────────────────────────────────────────
# SECTION 8 — KYC  (Veriff)
# ─────────────────────────────────────────────────────────────
# ⚠️  MULTI-SERVER WARNING ⚠️
# Veriff sends webhooks with HMAC-SHA256 signatures.
# ALL servers must verify with the EXACT SAME secret.
# If you set VERIFF_API_SECRET here, it overrides the Admin Panel.
# Ensure all servers have the same value — or set ONLY in Admin Panel and
# leave these blank in .env on all servers.
#
# Get keys at https://portal.veriff.com

# [IMPORTANT-MULTI] Veriff public API key
# VERIFF_API_KEY=

# [IMPORTANT-MULTI] Veriff private secret (used for HMAC-SHA256 webhook verification)
# VERIFF_API_SECRET=

# [OPTIONAL] Veriff API base URL (default: stationapi.veriff.com)
# VERIFF_BASE_URL=https://stationapi.veriff.com

# [OPTIONAL] Override URL Veriff redirects users to after verification
# VERIFF_CALLBACK_URL=https://yourdomain.com/kyc/callback


# ─────────────────────────────────────────────────────────────
# SECTION 9 — AI  (OpenAI)
# ─────────────────────────────────────────────────────────────
# Used for: AI chat assistant, marketplace content generation,
#           email personalization, strategy builder AI.
# Can also be set in Admin Panel > Settings > Environment Variables.

# [OPTIONAL] OpenAI API key
# OPENAI_API_KEY=sk-...

# [OPTIONAL] Model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] Master toggle for AI features
# OPENAI_ENABLED=true

# [OPTIONAL] Use AI for personalized email content
# OPENAI_FOR_EMAILS=false


# ─────────────────────────────────────────────────────────────
# SECTION 10 — PAYMENTS — Stripe
# ─────────────────────────────────────────────────────────────
# ⚠️  MULTI-SERVER WARNING ⚠️
# Stripe webhook verification uses STRIPE_WEBHOOK_SECRET.
# All servers receiving Stripe webhooks must use the same secret.
# Best practice: use ONE webhook endpoint (e.g. only primary server receives
# Stripe webhooks) or set the same secret on all servers.
#
# Get keys at https://dashboard.stripe.com

# [OPTIONAL] Stripe secret key (server-side only — NEVER expose to browser)
# STRIPE_SECRET_KEY=sk_live_...

# [OPTIONAL] Stripe publishable key (safe for browser)
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# [OPTIONAL] Webhook signing secret (from Stripe Dashboard > Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_...


# ─────────────────────────────────────────────────────────────
# SECTION 11 — PAYMENTS — Nuvei
# ─────────────────────────────────────────────────────────────
# [OPTIONAL] Nuvei merchant credentials
# NUVEI_MERCHANT_ID=
# NUVEI_SITE_ID=
# NUVEI_SECRET_KEY=
# NUVEI_TEST_MODE=false

# [OPTIONAL] Nuvei callback / redirect URLs
# NUVEI_DMN_URL=https://yourdomain.com/api/nuvei/webhook
# NUVEI_SUCCESS_URL=https://yourdomain.com/payment/success
# NUVEI_PENDING_URL=https://yourdomain.com/payment/pending
# NUVEI_BACK_URL=https://yourdomain.com/payment
# NUVEI_FAILURE_URL=https://yourdomain.com/payment/failed


# ─────────────────────────────────────────────────────────────
# SECTION 12 — PAYMENTS — Paddle (alternative)
# ─────────────────────────────────────────────────────────────
# [OPTIONAL] Paddle credentials
# PADDLE_VENDOR_ID=
# PADDLE_API_KEY=
# PADDLE_PUBLIC_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=production
# PADDLE_PRODUCT_ID=


# ─────────────────────────────────────────────────────────────
# SECTION 13 — BACKGROUND JOBS  (Inngest)
# ─────────────────────────────────────────────────────────────
# Leave blank to run background jobs in-process (default).
# Set keys to route jobs through Inngest Cloud for reliable delivery.
# Get keys at https://app.inngest.com

# [OPTIONAL] Inngest event key
# INNGEST_EVENT_KEY=

# [OPTIONAL] Inngest webhook signing key
# INNGEST_SIGNING_KEY=


# ─────────────────────────────────────────────────────────────
# SECTION 14 — PERFORMANCE TUNING  (optional)
# ─────────────────────────────────────────────────────────────

# [OPTIONAL] Number of web app instances (PM2 cluster mode)
# 1 = single process; 4 = 4 processes using 4 CPU cores
# WEB_INSTANCES=1

# [OPTIONAL] Admin app Node.js heap size in MB
# Increase if admin app runs out of memory on large datasets
# ADMIN_HEAP_MB=512

# [OPTIONAL] PM2 process name for admin app (used by heap management endpoint)
# PM2_ADMIN_APP_NAME=chartvolt-admin

# [OPTIONAL] MongoDB storage alert threshold in MB
# MONGODB_STORAGE_LIMIT_MB=


# ─────────────────────────────────────────────────────────────
# SECTION 15 — SIMULATOR  (development / testing only)
# ─────────────────────────────────────────────────────────────
# DO NOT enable in production — creates fake users and trades.

# [OPTIONAL] Enable trading simulator
# ENABLE_SIMULATOR=false

# [OPTIONAL] Password used for simulator test accounts
# SIMULATOR_TEST_PASSWORD=SimTest123!
