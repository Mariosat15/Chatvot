# ============================================
# CHARTVOLT GAMES - SERVICE CONFIGURATION
# ============================================
#
# Copy to `games-service/.env` on the server and fill in. The service REFUSES TO BOOT if any
# required value is missing, naming the variable on the first line of the log. That is
# deliberate: a service that starts and then rejects every call looks identical, in a
# dashboard, to a service under attack.
#
# This file is the provider's own configuration. It is not the platform's `.env` and must
# never be merged into it - see GAMES_MONGODB_URI below for the mistake that would cause.

# --------------------------------------------
# WHERE IT LISTENS AND WHERE PLAYERS REACH IT
# --------------------------------------------

# The loopback port. nginx proxies the games subdomain to it; PM2 also sets this.
PORT=4010

# The PLAY origin - the address a player's browser loads the game board from, which is what
# the launch URL is built out of.
#
# MANDATORY IN PRODUCTION, and it must be a non-loopback https address. The service refuses to
# boot otherwise, because both mistakes are invisible: a loopback origin points every player at
# their own machine, and a plain-http origin is blocked as mixed content inside the platform's
# https page. In each case the board is a blank rectangle and there is nothing in any log.
#
# This is a SEPARATE FACT from the API base URL you enter in the admin panel. That one is
# loopback, because the platform calls the API over the local interface; this one is public,
# because only the player's browser uses it. The provider specification treats them separately
# for exactly this reason, and pasting the API base URL here is the mistake to avoid.
GAMES_PUBLIC_URL=https://games.yourdomain.com

# Which origins may embed the game, as a CSP `frame-ancestors` value.
#
# MANDATORY IN PRODUCTION - the service refuses to boot without it. Unset, any site on the
# internet can embed a live round and overlay it, and a player cannot tell. Space-separate
# multiple origins, and include every origin players actually arrive on, `www` included: a
# missing one blanks the game in the player's browser with no server-side error to find.
GAMES_FRAME_ANCESTORS=https://yourdomain.com https://www.yourdomain.com

# --------------------------------------------
# ITS OWN DATABASE
# --------------------------------------------

# THE PROVIDER'S DATABASE, WHICH IS NOT THE PLATFORM'S.
#
# Pasting the platform's connection string here is the obvious mistake and it is the one this
# comment exists to prevent. Every guarantee the integration rests on - that a provider never
# touches money, that scores arrive only through the signed callback - is only genuinely true
# if this service cannot read the platform's data even by accident.
#
# The database NAME is set separately below and applied explicitly, so a shared cluster still
# keeps the collections apart. A separate cluster is better.
GAMES_MONGODB_URI=mongodb://127.0.0.1:27017/
GAMES_DB_NAME=chartvolt_games

# --------------------------------------------
# CREDENTIALS - FOUR VALUES IN TWO PAIRS
# --------------------------------------------
#
# The pairing is the part people get wrong, and getting it wrong produces a signature error
# that reads like an attack. Each pair travels in one direction only:
#
#   ISSUED BY US, USED BY THE PLATFORM   -> GAMES_API_KEY / GAMES_API_SECRET
#     The platform presents these when it calls us to open a round or read one.
#     In the admin credentials dialog they go in the group headed "issued to us by the
#     provider" - because from the platform's side, that is what they are.
#
#   ISSUED BY THE PLATFORM, USED BY US   -> GAMES_CALLBACK_TOKEN / GAMES_CALLBACK_SECRET
#     We present these when we post a result back. They must match the "callback token" and
#     "callback secret" stored on the same dialog, character for character.
#
# Generate each with:  openssl rand -hex 32
#
# All four are secrets. Rotate by setting the *_PREVIOUS variable to the old value, deploying
# the new one, then clearing the previous once the platform has been updated.

GAMES_API_KEY=
GAMES_API_SECRET=
# Optional, only during a rotation window. Absent is the normal state.
# GAMES_API_KEY_PREVIOUS=
# GAMES_API_SECRET_PREVIOUS=

GAMES_CALLBACK_TOKEN=
GAMES_CALLBACK_SECRET=

# --------------------------------------------
# OPTIONAL
# --------------------------------------------

# Where catalogue artwork is served from. Defaults to GAMES_PUBLIC_URL, which is almost
# always right.
# GAMES_ASSET_BASE_URL=https://games.yourdomain.com

# Restricts which hosts a result may be posted to. Empty means no restriction, which is the
# correct default for a provider serving one platform whose address it is told per round.
# Set it to the platform's hostname as a belt-and-braces measure if you like.
# GAMES_CALLBACK_HOST_ALLOWLIST=yourdomain.com

# ============================================
# LEAVE THIS OFF IN PRODUCTION
# ============================================
#
# Sandbox mode enables the specification's test controls: force a score, force a terminal
# state, suppress a callback. A forced score DECIDES REAL PRIZE MONEY on a paid contest.
#
# It defaults to false, so the safe value is the one you get by leaving this line alone. The
# service logs a loud warning at boot when it is on, and the nginx config additionally makes
# the endpoints unreachable from the internet - two independent reasons it cannot bite you in
# production, which is how it should stay.
GAMES_SANDBOX=false
