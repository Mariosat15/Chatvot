{
  "name": "chartvolt-games-service",
  "version": "1.0.0",
  "description": "ChartVolt Games - a first-party game provider, implemented strictly against the issued ChartVolt Game API Requirements. Deliberately shares NO code with the ChartVolt platform.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx index.ts",
    "setup:env": "tsx tools/setup-env.ts",
    "check:isolation": "tsx tools/check-isolation.ts",
    "typecheck": "tsc --noEmit",
    "test:config": "tsx tools/test-config.ts",
    "test:engine": "tsx tools/test-engine.ts",
    "test:scoring": "tsx tools/test-scoring.ts",
    "test:api": "tsx tools/test-api.ts",
    "test:play": "tsx tools/test-play.ts",
    "test:board": "tsx tools/test-board.ts",
    "test": "npm run check:isolation && npm run typecheck && npm run test:config && npm run test:engine && npm run test:scoring && npm run test:api && npm run test:play && npm run test:board",
    "probe:config": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe-config.ps1",
    "probe:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe-engine.ps1",
    "probe:scoring": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe-scoring.ps1",
    "probe:api": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe-api.ps1",
    "probe:board": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/probe-board.ps1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
