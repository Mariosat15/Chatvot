{
  "name": "chartvolt-games-service",
  "version": "1.0.0",
  "description": "ChartVolt Games - a first-party game provider, implemented strictly against the issued ChartVolt Game API Requirements. Deliberately shares NO code with the ChartVolt platform.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
