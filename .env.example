# =============================================================================
# Chartvolt — Example Environment File
# =============================================================================
# This file documents NON-SECRET environment variables that developers may need
# to enable optional features. Copy the block(s) you need into your local
# `.env` (which is gitignored) and fill in real values.
#
# NEVER commit a populated `.env` file. Only `.env.example` is tracked by git.
# =============================================================================


# -----------------------------------------------------------------------------
# Card-Testing Attack Simulation Suite (admin-only, OFF by default)
# -----------------------------------------------------------------------------
# These variables enable the "Attack Suite" tab in the admin Performance
# Simulator. The suite fires six read-only / simulator-only scenarios against
# the anti-fraud defenses (per-user + per-IP deposit rate limits, decline
# velocity block, Nuvei webhook HMAC + idempotency) to prove they keep
# working. Full details in the admin wiki under
# "Card Testing & Payment Fraud Protection" → "How to verify these defenses".
#
# Security model (7 layers, all must pass or the endpoints return 403):
#   1. SIMULATOR_ATTACK_TESTS_ENABLED must be exactly "true"
#   2. Requests must carry X-Simulator-Attack-Secret matching
#      SIMULATOR_ATTACK_SECRET (constant-time compare)
#   3. Requests must originate from loopback (127.0.0.1 / ::1)
#   4. Any userId parameter must start with "sim-attack-"
#   5. Self rate-limit: 60 attack calls / min / IP
#   6. Admin UI kickoff requires requireAdminAuth()
#   7. Every run is audit-logged (category: "security")
#
# Recommended setting in production: leave BOTH unset. Enable only on
# developer machines or isolated staging boxes when you want to regression-
# test the anti-fraud layer.
# -----------------------------------------------------------------------------

# Master on/off switch. Anything other than the literal string "true" keeps
# every /api/simulator/attack/* route closed.
SIMULATOR_ATTACK_TESTS_ENABLED=false

# 32-byte hex shared secret. Generate with:
#   openssl rand -hex 32
# (or on Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# )
# Leave blank to keep the suite unreachable even if the flag above is true.
SIMULATOR_ATTACK_SECRET=

# Optional: base URL the admin kickoff route uses to reach the main Next.js
# app's /api/simulator/attack/* endpoints. Defaults to http://127.0.0.1:3000.
# Override only if the main app listens on a non-default host/port.
# MAIN_APP_URL=http://127.0.0.1:3000
