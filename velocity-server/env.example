# Volt Velocity race server. Copy to velocity-server/.env (the root .gitignore ignores .env*,
# which is why this file has no leading dot). Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot if either is shorter than 32 characters or if they are equal.
# games-service needs the SAME two values (as VELOCITY_TICKET_SECRET / VELOCITY_ADMIN_KEY) to
# create races, issue tickets and verify result receipts. Nothing else may hold them.
RACE_TICKET_SECRET=
RACE_ADMIN_KEY=
# The browser origin the race client runs on (the platform origin, since /play is proxied there).
RACE_ALLOWED_ORIGINS=https://chartvolt.com
# Loopback only: nginx exposes the six player endpoints under /race/, games-service reaches the
# admin endpoints directly.
HOST=127.0.0.1
PORT=3080
RACE_DATA_DIR=/var/lib/chartvolt/volt-velocity-results
