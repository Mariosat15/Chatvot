; Reason: better-auth declares a peerOptional on vitest@^4, but the test suite is pinned
; to vitest@3.2.4 by @vitest/coverage-v8. npm treats even an optional peer as a hard
; ERESOLVE failure here, so a plain `npm install` aborts on the root project.
;
; This was previously worked around by typing --legacy-peer-deps on every install, which
; deploy/deploy.sh does not do - so the script died on its first step and the deploy had
; to be hand-rolled. Setting it here makes the flag apply everywhere, including CI.
;
; Only the root project needs this; apps/admin, api-server and websocket-server all
; resolve cleanly without it. Revisit when better-auth supports vitest 3.x as a peer.
legacy-peer-deps=true

; Reason: even with nothing to install, `npm install` calls the registry for advisory and
; funding metadata, and npmjs is retiring the endpoint npm uses for it - the tell in a
; deploy log is "npm notice This endpoint is being retired". When that call is throttled it
; stalls for MINUTES per project. Measured 4 Sep 2026 on a tree with no dependency changes:
; root 15s (new bulk endpoint, worked), apps/admin 6m and api-server 7m (old endpoint,
; stalled) - about 13 minutes of a deploy spent fetching metadata nobody read.
;
; Set here rather than only in deploy/deploy.sh so a hand-typed `npm install` is fast too.
; This does NOT reduce security cover: `npm audit` still works and is the right way to ask
; the question deliberately. Auditing mid-deploy answers after the code is already live.
;
; NOTE: npm does not inherit this from a parent directory - it stops at the nearest
; package.json - so apps/admin, api-server and websocket-server each need their own copy.
audit=false
fund=false
