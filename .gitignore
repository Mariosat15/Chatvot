/node_modules
node_modules/
.next
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Admin app
apps/admin/node_modules/
apps/admin/.next/
apps/*/node_modules/
apps/*/.next/

# Worker
worker/dist/

# API Server
api-server/dist/

# WebSocket Server
websocket-server/dist/

# Dist
dist/

# Runtime uploads (user-generated - NOT defaults)
public/uploads/profiles/
public/uploads/avatars/
public/uploads/cosmetics/
public/uploads/indicators/
public/uploads/strategies/
public/uploads/gamemaster/

# Marketplace images - track default .webp images but ignore user uploads
# Use: git add -f public/uploads/marketplace/*.webp to add new defaults
public/uploads/marketplace/*
!public/uploads/marketplace/*.webp

# Tutorial chunked-upload temp folder (never commit in-flight chunks)
Videos/.tmp-uploads/

# Database backups (server-side snapshots created from Admin > Database > Backup)
# Reason: snapshots contain every document incl. secrets — never commit them.
# Anchored to the repo root so it does NOT match source folders named "backups"
# (e.g. app/api/database/backups route handlers).
/backups/

# Logs
logs/
*.log

# PM2
.pm2/

# Debug
.cursor/debug.log

# OS
Thumbs.db
desktop.ini

# eslint output
eslint-output.txt

# Emitted TypeScript declarations.
# Reason: 57 of these plus their source maps were committed by accident in Feb 2026,
# went stale immediately, and were mistaken for a third copy of the models that had to
# be kept in step with database/ and apps/admin/database/. They never were: TypeScript
# resolves the sibling .ts first, so they were inert. Deleted 1 Sep 2026 after proving
# removal left the typecheck byte-identical (16 errors main, 225 admin, before and after).
# tsconfig is noEmit, so nothing regenerates them - these rules only stop a stray
# `tsc -d` run putting them back.
# Note the negation below: types/global.d.ts is hand-written and must stay tracked.
*.d.ts
*.d.ts.map
!types/global.d.ts
!next-env.d.ts
!websocket-server/dist/index.d.ts
